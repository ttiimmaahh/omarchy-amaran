# Fallback template. Prefer `tools/amaran-setup`, which generates this file
# with your actual paths filled in — the two placeholders below are the usual
# cause of a service that installs fine and then never starts.
#
#   mkdir -p ~/.config/systemd/user
#   cp amaran-daemon.service ~/.config/systemd/user/
#   $EDITOR ~/.config/systemd/user/amaran-daemon.service   # fix BOTH paths
#   systemctl --user daemon-reload
#   systemctl --user enable --now amaran-daemon
#
# WorkingDirectory must be the checkout holding your lights.json: the daemon
# reads it from the current directory, not from an absolute path.
#
# ExecStart must be ABSOLUTE. A systemd user unit does not inherit your shell's
# PATH, so a version-managed Node (mise, nvm, asdf, fnm) is invisible to it.
# Find yours with:
#
#   readlink -f "$(command -v node)"
#
# and use "<that> <WorkingDirectory>/node_modules/.bin/tsx src/daemon.ts".

[Unit]
Description=amaran BLE mesh daemon (REST API for amaran/Aputure lights)
Documentation=https://github.com/ttiimmaahh/amaran-BLE-control
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.config/amaran-BLE-control
# User services cannot start the system bluetooth.service. Fail before Node
# launches if BlueZ is down, because the Linux D-Bus transport depends on it.
ExecStartPre=/usr/bin/systemctl is-active --quiet bluetooth.service
ExecStart=/usr/bin/node %h/.config/amaran-BLE-control/node_modules/.bin/tsx src/daemon.ts
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=10

# A patched BlueZ D-Bus transport needs no raw-HCI capabilities on node. If an
# earlier attempt granted them, you can remove them with:
#   sudo setcap -r "$(readlink -f "$(which node)")"

[Install]
WantedBy=default.target
