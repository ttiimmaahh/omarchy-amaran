#!/usr/bin/env bash
# Interactive setup for the amaran BLE daemon that the Omarchy widget drives.
#
# This is where the mesh keys go. Run it on the machine with the Bluetooth
# radio — the panel's "Set up lights" button launches it in a terminal.
#
#   amaran-setup [daemon-directory]

set -uo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DEFAULT_DIR="$CONFIG_HOME/amaran-BLE-control"

# An earlier version defaulted to ~/amaran-BLE-control. If someone already has
# a checkout there, keep using it rather than quietly cloning a second copy —
# theirs is the one holding their keys.
LEGACY_DIR="$HOME/amaran-BLE-control"
if [[ -z ${1:-} && ! -d $DEFAULT_DIR && -d $LEGACY_DIR ]]; then
  DEFAULT_DIR="$LEGACY_DIR"
fi

DAEMON_DIR="${1:-$DEFAULT_DIR}"
REPO_URL="https://github.com/ttiimmaahh/amaran-BLE-control.git"

bold()  { printf '\033[1m%s\033[0m\n' "$*"; }
dim()   { printf '\033[2m%s\033[0m\n' "$*"; }
warn()  { printf '\033[33m%s\033[0m\n' "$*"; }
err()   { printf '\033[31m%s\033[0m\n' "$*" >&2; }
ok()    { printf '\033[32m%s\033[0m\n' "$*"; }

pause_exit() {
  echo
  dim "Press any key to close this window."
  read -rsn1 || true
  exit "${1:-0}"
}

ask() {
  local prompt="$1" default="${2:-}" reply
  if [[ -n $default ]]; then
    read -rp "$prompt [$default]: " reply || true
    echo "${reply:-$default}"
  else
    read -rp "$prompt: " reply || true
    echo "$reply"
  fi
}

# Keys are secrets: read them hidden so they never land in scrollback, then
# echo only enough for the user to confirm the paste worked.
ask_key() {
  local label="$1" reply
  while true; do
    read -rsp "$label (32 hex characters, input hidden): " reply || true
    # Everything but the key itself goes to stderr: this function's stdout is
    # captured by the caller, so a stray echo would end up inside the key.
    echo >&2
    reply="${reply// /}"
    reply="${reply^^}"
    if [[ $reply =~ ^[0-9A-F]{32}$ ]]; then
      dim "  got ${reply:0:4}…${reply: -4}" >&2
      echo "$reply"
      return 0
    fi
    err "  That is not 32 hex characters (got ${#reply}). Try again."
  done
}

confirm() {
  local reply
  read -rp "$1 [y/N]: " reply || true
  [[ ${reply,,} == y* ]]
}

# Turn a fixture name into a stable daemon key, and suffix duplicates with the
# mesh address. Plain string bookkeeping keeps this compatible with macOS's
# older /bin/bash, which has no associative arrays.
USED_KEYS="|"
UNIQUE_KEY_RESULT=""
unique_key() {
  local base="$1" suffix="$2" candidate n
  candidate="$base"
  [[ -n $candidate ]] || candidate="light$suffix"
  if [[ $USED_KEYS == *"|$candidate|"* ]]; then
    candidate="${base}${suffix}"
    [[ -n $base ]] || candidate="light$suffix"
    n=2
    while [[ $USED_KEYS == *"|$candidate|"* ]]; do
      candidate="${base}${suffix}${n}"
      n=$((n + 1))
    done
  fi
  USED_KEYS+="$candidate|"
  UNIQUE_KEY_RESULT="$candidate"
}

repair_duplicate_keys() {
  local file="$1" result
  [[ -f $file ]] || return 0
  if ! command -v node >/dev/null; then
    warn "Cannot check for duplicate fixture keys because node is not on PATH."
    return 0
  fi

  result=$(node - "$file" <<'NODE'
const fs = require("fs");
const file = process.argv[2];
const config = JSON.parse(fs.readFileSync(file, "utf8"));
if (!Array.isArray(config.lights)) process.exit(0);

const used = new Set();
let changed = false;

function slug(name, address) {
  const base = String(name || "")
    .toLowerCase()
    .replace(/[^a-z0-9]/g, "")
    .slice(0, 8);
  return base || `light${address || used.size + 1}`;
}

for (const light of config.lights) {
  const current = String(light.key || "");
  const base = slug(light.name, light.address);
  let next = current || base;

  if (used.has(next)) {
    const suffix = light.address || used.size + 1;
    next = `${base}${suffix}`;
    let n = 2;
    while (used.has(next)) next = `${base}${suffix}${n++}`;
  }

  used.add(next);
  if (next !== current) {
    light.key = next;
    changed = true;
  }
}

if (changed) {
  fs.writeFileSync(file, JSON.stringify(config, null, 2) + "\n");
  console.log("repaired");
}
NODE
  ) || { err "Could not validate $file"; return 1; }

  if [[ $result == repaired ]]; then
    ok "Repaired duplicate fixture keys in $file"
    dim "Each fixture needs its own key, otherwise individual controls collapse together."
  fi
}

bold "amaran light setup"
echo
cat <<'INTRO'
Your lights speak Bluetooth Mesh, and joining that mesh needs two secrets:
a network key and an application key. They are generated by the amaran app
when it first pairs your lights, and the only practical way to read them is
out of the amaran Desktop app's database on a Mac or Windows machine.

If you have not done that yet, stop here and run tools/amaran-export-keys.sh
on that machine first — it writes a lights.json you can import below.
INTRO
echo

# ---- 1. The daemon ---------------------------------------------------------

bold "1. The daemon"
DAEMON_DIR=$(ask "Where should the amaran BLE daemon live" "$DAEMON_DIR")
DAEMON_DIR="${DAEMON_DIR/#\~/$HOME}"

if [[ ! -d $DAEMON_DIR ]]; then
  warn "Not found: $DAEMON_DIR"
  if confirm "Clone $REPO_URL there"; then
    command -v git >/dev/null || { err "git is not installed."; pause_exit 1; }
    git clone "$REPO_URL" "$DAEMON_DIR" || { err "Clone failed."; pause_exit 1; }
  else
    err "Cannot continue without the daemon."
    pause_exit 1
  fi
fi

if [[ ! -d "$DAEMON_DIR/node_modules" ]]; then
  if confirm "Install its dependencies now (npm install)"; then
    command -v npm >/dev/null || { err "npm is not installed."; pause_exit 1; }
    (cd "$DAEMON_DIR" && npm install) || { err "npm install failed."; pause_exit 1; }
  fi
fi

CONFIG="$DAEMON_DIR/lights.json"
echo

# ---- 2. The keys -----------------------------------------------------------

bold "2. Mesh keys and fixtures"

if [[ -f $CONFIG ]]; then
  dim "There is already a config at $CONFIG"
  if ! confirm "Replace it"; then
    ok "Keeping the existing config."
    CONFIG_KEPT=1
  fi
fi

if [[ -z ${CONFIG_KEPT:-} ]]; then
  echo
  echo "  1) Import a lights.json exported from amaran Desktop (recommended)"
  echo "  2) Type the keys and fixtures in by hand"
  echo
  CHOICE=$(ask "Choose" "1")

  if [[ $CHOICE == 1 ]]; then
    while true; do
      SRC=$(ask "Path to the exported lights.json")
      SRC="${SRC/#\~/$HOME}"
      if [[ -f $SRC ]]; then
        if command -v jq >/dev/null && ! jq -e '.netKey and .appKey and (.lights | length > 0)' "$SRC" >/dev/null 2>&1; then
          err "  That file has no netKey/appKey/lights. Is it the right one?"
          confirm "  Use it anyway" || continue
        fi
        install -m 600 "$SRC" "$CONFIG" || { err "Could not write $CONFIG"; pause_exit 1; }
        ok "Imported to $CONFIG"
        break
      fi
      err "  No such file: $SRC"
    done
  else
    NET_KEY=$(ask_key "Network key")
    APP_KEY=$(ask_key "Application key")

    echo
    dim "Now the fixtures. You need each light's Bluetooth MAC and its mesh"
    dim "address (a small number, usually 2, 4, 6 …). Both are listed in the"
    dim "export script's output, or in amaran Desktop's fixture details."
    echo

    LIGHTS=""
    INDEX=1
    while true; do
      echo "Light $INDEX:"
      NAME=$(ask "  Name (e.g. Key Light)")
      [[ -n $NAME ]] || NAME="Light $INDEX"

      while true; do
        MAC=$(ask "  MAC address (AA:BB:CC:DD:EE:FF)")
        MAC="${MAC^^}"
        [[ $MAC =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]] && break
        err "    Not a MAC address. Try again."
      done

      while true; do
        ADDR=$(ask "  Mesh address" "$((INDEX * 2))")
        [[ $ADDR =~ ^[0-9]+$ ]] && (( ADDR >= 2 )) && break
        err "    Mesh address must be a whole number of 2 or more."
      done

      KEY_BASE=$(echo "$NAME" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9' | cut -c1-8)
      unique_key "$KEY_BASE" "$ADDR"
      KEY="$UNIQUE_KEY_RESULT"

      [[ -n $LIGHTS ]] && LIGHTS+=",
"
      LIGHTS+="    { \"key\": \"$KEY\", \"name\": \"$NAME\", \"mac\": \"$MAC\", \"address\": $ADDR }"
      [[ -z ${RELAY:-} ]] && RELAY="$MAC"

      INDEX=$((INDEX + 1))
      echo
      confirm "Add another light" || break
    done

    umask 077
    cat > "$CONFIG" <<JSON
{
  "netKey": "$NET_KEY",
  "appKey": "$APP_KEY",
  "relayHub": "$RELAY",
  "http": { "port": 2708, "host": "127.0.0.1" },
  "lights": [
$LIGHTS
  ]
}
JSON
    chmod 600 "$CONFIG"
    ok "Wrote $CONFIG"
  fi
fi

repair_duplicate_keys "$CONFIG" || pause_exit 1

echo

# ---- 3. Radio and permissions ---------------------------------------------

bold "3. Bluetooth"

# The class directory appears as soon as the `bluetooth` module loads, with or
# without hardware behind it — so count actual hci* adapters instead.
ADAPTERS=$(ls -1 /sys/class/bluetooth/ 2>/dev/null | grep -c '^hci' || true)

if [[ ${ADAPTERS:-0} -eq 0 ]]; then
  if [[ -d /sys/class/bluetooth ]]; then
    warn "No Bluetooth adapter: the bluetooth module is loaded, but no hci device registered."
    dim "If this is a Windows/Linux dual-boot machine, disable Windows Fast"
    dim "Startup and do a full shutdown / power drain before chasing BIOS settings."
    dim "Then check 'sudo dmesg | grep -i bluetooth' for enumeration errors."
  else
    warn "No Bluetooth adapter on this machine — /sys/class/bluetooth does not exist."
    dim "If this is a Windows/Linux dual-boot machine, disable Windows Fast"
    dim "Startup and do a full shutdown / power drain before chasing BIOS settings."
    dim "Otherwise plug in a BLE dongle, or enable the built-in radio in your BIOS."
  fi
  dim "Alternatively run the daemon on another machine and point the widget"
  dim "at it with the widget's 'host' setting."
else
  ok "Bluetooth adapter present ($ADAPTERS)."

  # BlueZ must be running: it is what powers the adapter. A D-Bus transport
  # needs nothing else — no capabilities, because BlueZ owns the controller.
  if command -v systemctl >/dev/null; then
    if systemctl is-active --quiet bluetooth; then
      ok "bluetooth.service is running."
    else
      warn "bluetooth.service is not running — BlueZ is what powers the adapter."
      echo "  sudo systemctl unmask bluetooth && sudo systemctl enable --now bluetooth"
    fi
  fi

  # The stock upstream daemon uses noble, which on Linux bypasses BlueZ and
  # drives raw HCI. That needs cap_net_raw AND cap_net_admin just to reach
  # poweredOn — and even then it contends with BlueZ for the connection. Say so
  # rather than granting privileges that will not actually make it work.
  NODE_BIN=$(readlink -f "$(command -v node)" 2>/dev/null || true)
  if [[ -n $NODE_BIN ]] && command -v getcap >/dev/null; then
    if getcap "$NODE_BIN" 2>/dev/null | grep -q cap_net_raw; then
      dim "node currently holds raw-HCI capabilities. A BlueZ D-Bus transport"
      dim "does not need them; you can drop them with:"
      dim "  sudo setcap -r $NODE_BIN"
    fi
  fi
  dim "On Linux the daemon needs a BlueZ D-Bus transport; the stock upstream"
  dim "daemon drives raw HCI and will not connect. See the README."
fi

echo

# ---- 4. Start it -----------------------------------------------------------

bold "4. Start the daemon"

PORT=2708
if command -v jq >/dev/null && [[ -f $CONFIG ]]; then
  PORT=$(jq -r '.http.port // 2708' "$CONFIG" 2>/dev/null || echo 2708)
fi

UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
UNIT="$UNIT_DIR/amaran-daemon.service"

# Build the unit here rather than shipping a fixed one: only this script knows
# which directory you chose, and a systemd user unit gets a bare PATH — it does
# not inherit the shell's, so a version-managed Node (mise, nvm, asdf, fnm) is
# invisible to it unless every path is resolved to an absolute one now.
write_unit() {
  local node_bin tsx_bin exec_line systemctl_bin
  node_bin=$(readlink -f "$(command -v node 2>/dev/null)" 2>/dev/null || true)
  if [[ -z $node_bin ]]; then
    err "node is not on PATH — cannot write a service that would start."
    return 1
  fi

  systemctl_bin=$(readlink -f "$(command -v systemctl 2>/dev/null)" 2>/dev/null || echo /usr/bin/systemctl)

  tsx_bin="$DAEMON_DIR/node_modules/.bin/tsx"
  if [[ -x $tsx_bin ]]; then
    # Call tsx directly. npx would be a second resolution step that can try to
    # reach the network on a cache miss.
    exec_line="$node_bin $tsx_bin src/daemon.ts"
  else
    local npx_bin
    npx_bin=$(readlink -f "$(command -v npx 2>/dev/null)" 2>/dev/null || true)
    [[ -n $npx_bin ]] || { err "neither $tsx_bin nor npx found — run npm install first."; return 1; }
    warn "  tsx is not installed yet; falling back to npx (run npm install to fix)."
    exec_line="$npx_bin tsx src/daemon.ts"
  fi

  mkdir -p "$UNIT_DIR" || return 1
  cat > "$UNIT" <<UNITFILE
# Generated by amaran-setup on $(date -Iseconds). Re-run it after moving the
# daemon or changing Node versions — every path below is absolute on purpose.
[Unit]
Description=amaran BLE mesh daemon (REST API for amaran/Aputure lights)
Documentation=https://github.com/ttiimmaahh/amaran-BLE-control
After=network.target

[Service]
Type=simple
WorkingDirectory=$DAEMON_DIR
# User services cannot start the system bluetooth.service. Fail before Node
# launches if BlueZ is down, because the Linux D-Bus transport depends on it.
ExecStartPre=$systemctl_bin is-active --quiet bluetooth.service
ExecStart=$exec_line
Environment=PATH=$(dirname "$node_bin"):/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
UNITFILE

  systemctl --user daemon-reload || return 1
  return 0
}

verify_daemon_after_start() {
  local url="http://127.0.0.1:$PORT/lights"
  local deadline=$((SECONDS + 30))
  dim "Waiting for the daemon API at $url …"
  while (( SECONDS < deadline )); do
    if curl -fsS --max-time 2 "$url" >/dev/null 2>&1; then
      ok "Daemon API is answering."
      return 0
    fi
    sleep 2
  done

  warn "The service started, but the daemon API never answered at $url."
  dim "The daemon binds HTTP only after it connects to the BLE mesh, so this"
  dim "usually means the Bluetooth connection step is stuck or failing."
  if command -v systemctl >/dev/null && ! systemctl is-active --quiet bluetooth.service; then
    warn "bluetooth.service is not running. BlueZ must be active for the Linux transport:"
    echo "  sudo systemctl unmask bluetooth && sudo systemctl enable --now bluetooth"
  fi
  dim "On Linux, the stock noble/raw-HCI daemon commonly hangs here. Use the"
  dim "patched BlueZ D-Bus daemon described in the README, close amaran Desktop"
  dim "and the phone app, then restart this service."
  echo
  dim "Recent service log:"
  journalctl --user -u amaran-daemon.service --no-pager -n 30 2>&1 | sed 's/^/  /'
  return 1
}

if curl -fsS --max-time 2 "http://127.0.0.1:$PORT/" >/dev/null 2>&1; then
  ok "A daemon is already answering on port $PORT."
else
  dim "Start it in the foreground with:"
  echo "  cd $DAEMON_DIR && npm run daemon:start"
  echo

  if [[ -f $UNIT ]]; then
    ok "A systemd user service is already installed at $UNIT"
    if confirm "Rewrite it for this directory and Node version"; then
      write_unit && ok "Rewrote $UNIT"
    fi
  elif confirm "Install a systemd user service so the daemon starts on login"; then
    if write_unit; then
      ok "Installed $UNIT"
      if confirm "Start it now"; then
        if systemctl --user enable --now amaran-daemon.service; then
          sleep 2
          if systemctl --user is-active --quiet amaran-daemon.service; then
            ok "amaran-daemon process is running."
            verify_daemon_after_start || pause_exit 1
          else
            warn "amaran-daemon did not stay up. Its log:"
            systemctl --user status amaran-daemon.service --no-pager -n 15 2>&1 | sed 's/^/  /'
          fi
        else
          err "systemctl could not enable the service."
        fi
      else
        dim "Start it later with:  systemctl --user enable --now amaran-daemon"
      fi
    fi
  else
    dim "You can install it later by re-running this script."
  fi
fi

echo
ok "Done. The widget polls every few seconds — or press r in the panel."
dim "Config: $CONFIG (keep it private; it holds your mesh keys)"
pause_exit 0
