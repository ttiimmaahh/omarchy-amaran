#!/usr/bin/env bash
# Interactive setup for the amaran BLE daemon that the Omarchy widget drives.
#
# This is where the mesh keys go. Run it on the machine with the Bluetooth
# radio — the panel's "Set up lights" button launches it in a terminal.
#
#   amaran-setup [daemon-directory]

set -uo pipefail

DAEMON_DIR="${1:-$HOME/amaran-BLE-control}"
REPO_URL="https://github.com/wesbos/amaran-BLE-control.git"

bold()  { printf '\033[1m%s\033[0m\n' "$*"; }
dim()   { printf '\033[2m%s\033[0m\n' "$*"; }
warn()  { printf '\033[33m%s\033[0m\n' "$*"; }
err()   { printf '\033[31m%s\033[0m\n' "$*" >&2; }
ok()    { printf '\033[32m%s\033[0m\n' "$*"; }

pause_exit() {
  echo
  dim "Press any key to close this window."
  read -rsn1 || true
  exit "${1:-0}"
}

ask() {
  local prompt="$1" default="${2:-}" reply
  if [[ -n $default ]]; then
    read -rp "$prompt [$default]: " reply || true
    echo "${reply:-$default}"
  else
    read -rp "$prompt: " reply || true
    echo "$reply"
  fi
}

# Keys are secrets: read them hidden so they never land in scrollback, then
# echo only enough for the user to confirm the paste worked.
ask_key() {
  local label="$1" reply
  while true; do
    read -rsp "$label (32 hex characters, input hidden): " reply || true
    # Everything but the key itself goes to stderr: this function's stdout is
    # captured by the caller, so a stray echo would end up inside the key.
    echo >&2
    reply="${reply// /}"
    reply="${reply^^}"
    if [[ $reply =~ ^[0-9A-F]{32}$ ]]; then
      dim "  got ${reply:0:4}…${reply: -4}" >&2
      echo "$reply"
      return 0
    fi
    err "  That is not 32 hex characters (got ${#reply}). Try again."
  done
}

confirm() {
  local reply
  read -rp "$1 [y/N]: " reply || true
  [[ ${reply,,} == y* ]]
}

bold "amaran light setup"
echo
cat <<'INTRO'
Your lights speak Bluetooth Mesh, and joining that mesh needs two secrets:
a network key and an application key. They are generated by the amaran app
when it first pairs your lights, and the only practical way to read them is
out of the amaran Desktop app's database on a Mac or Windows machine.

If you have not done that yet, stop here and run tools/amaran-export-keys.sh
on that machine first — it writes a lights.json you can import below.
INTRO
echo

# ---- 1. The daemon ---------------------------------------------------------

bold "1. The daemon"
DAEMON_DIR=$(ask "Where should the amaran BLE daemon live" "$DAEMON_DIR")
DAEMON_DIR="${DAEMON_DIR/#\~/$HOME}"

if [[ ! -d $DAEMON_DIR ]]; then
  warn "Not found: $DAEMON_DIR"
  if confirm "Clone $REPO_URL there"; then
    command -v git >/dev/null || { err "git is not installed."; pause_exit 1; }
    git clone "$REPO_URL" "$DAEMON_DIR" || { err "Clone failed."; pause_exit 1; }
  else
    err "Cannot continue without the daemon."
    pause_exit 1
  fi
fi

if [[ ! -d "$DAEMON_DIR/node_modules" ]]; then
  if confirm "Install its dependencies now (npm install)"; then
    command -v npm >/dev/null || { err "npm is not installed."; pause_exit 1; }
    (cd "$DAEMON_DIR" && npm install) || { err "npm install failed."; pause_exit 1; }
  fi
fi

CONFIG="$DAEMON_DIR/lights.json"
echo

# ---- 2. The keys -----------------------------------------------------------

bold "2. Mesh keys and fixtures"

if [[ -f $CONFIG ]]; then
  dim "There is already a config at $CONFIG"
  if ! confirm "Replace it"; then
    ok "Keeping the existing config."
    CONFIG_KEPT=1
  fi
fi

if [[ -z ${CONFIG_KEPT:-} ]]; then
  echo
  echo "  1) Import a lights.json exported from amaran Desktop (recommended)"
  echo "  2) Type the keys and fixtures in by hand"
  echo
  CHOICE=$(ask "Choose" "1")

  if [[ $CHOICE == 1 ]]; then
    while true; do
      SRC=$(ask "Path to the exported lights.json")
      SRC="${SRC/#\~/$HOME}"
      if [[ -f $SRC ]]; then
        if command -v jq >/dev/null && ! jq -e '.netKey and .appKey and (.lights | length > 0)' "$SRC" >/dev/null 2>&1; then
          err "  That file has no netKey/appKey/lights. Is it the right one?"
          confirm "  Use it anyway" || continue
        fi
        install -m 600 "$SRC" "$CONFIG" || { err "Could not write $CONFIG"; pause_exit 1; }
        ok "Imported to $CONFIG"
        break
      fi
      err "  No such file: $SRC"
    done
  else
    NET_KEY=$(ask_key "Network key")
    APP_KEY=$(ask_key "Application key")

    echo
    dim "Now the fixtures. You need each light's Bluetooth MAC and its mesh"
    dim "address (a small number, usually 2, 4, 6 …). Both are listed in the"
    dim "export script's output, or in amaran Desktop's fixture details."
    echo

    LIGHTS=""
    INDEX=1
    while true; do
      echo "Light $INDEX:"
      NAME=$(ask "  Name (e.g. Key Light)")
      [[ -n $NAME ]] || NAME="Light $INDEX"

      while true; do
        MAC=$(ask "  MAC address (AA:BB:CC:DD:EE:FF)")
        MAC="${MAC^^}"
        [[ $MAC =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]] && break
        err "    Not a MAC address. Try again."
      done

      while true; do
        ADDR=$(ask "  Mesh address" "$((INDEX * 2))")
        [[ $ADDR =~ ^[0-9]+$ ]] && (( ADDR >= 2 )) && break
        err "    Mesh address must be a whole number of 2 or more."
      done

      KEY=$(echo "$NAME" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9' | cut -c1-8)
      [[ -n $KEY ]] || KEY="light$ADDR"

      [[ -n $LIGHTS ]] && LIGHTS+=",
"
      LIGHTS+="    { \"key\": \"$KEY\", \"name\": \"$NAME\", \"mac\": \"$MAC\", \"address\": $ADDR }"
      [[ -z ${RELAY:-} ]] && RELAY="$MAC"

      INDEX=$((INDEX + 1))
      echo
      confirm "Add another light" || break
    done

    umask 077
    cat > "$CONFIG" <<JSON
{
  "netKey": "$NET_KEY",
  "appKey": "$APP_KEY",
  "relayHub": "$RELAY",
  "http": { "port": 2708, "host": "127.0.0.1" },
  "lights": [
$LIGHTS
  ]
}
JSON
    chmod 600 "$CONFIG"
    ok "Wrote $CONFIG"
  fi
fi

echo

# ---- 3. Radio and permissions ---------------------------------------------

bold "3. Bluetooth"

if [[ ! -d /sys/class/bluetooth ]]; then
  warn "No Bluetooth adapter on this machine — /sys/class/bluetooth does not exist."
  dim "Plug in a BLE dongle, or enable the built-in radio in your BIOS."
  dim "Alternatively run the daemon on another machine and point the widget"
  dim "at it with the widget's 'host' setting."
else
  ok "Bluetooth adapter present."
  NODE_BIN=$(readlink -f "$(command -v node)" 2>/dev/null || true)
  if [[ -n $NODE_BIN ]] && command -v getcap >/dev/null; then
    if ! getcap "$NODE_BIN" 2>/dev/null | grep -q cap_net_raw; then
      warn "node lacks CAP_NET_RAW, which the daemon needs for raw HCI access."
      echo "  sudo setcap cap_net_raw+eip $NODE_BIN"
      if confirm "Run that now (asks for your password)"; then
        sudo setcap cap_net_raw+eip "$NODE_BIN" && ok "Capability granted."
      fi
    else
      ok "node already has CAP_NET_RAW."
    fi
  fi
fi

echo

# ---- 4. Start it -----------------------------------------------------------

bold "4. Start the daemon"

PORT=2708
if command -v jq >/dev/null && [[ -f $CONFIG ]]; then
  PORT=$(jq -r '.http.port // 2708' "$CONFIG" 2>/dev/null || echo 2708)
fi

if curl -fsS --max-time 2 "http://127.0.0.1:$PORT/" >/dev/null 2>&1; then
  ok "A daemon is already answering on port $PORT."
else
  dim "Start it in the foreground with:"
  echo "  cd $DAEMON_DIR && npm run daemon:start"
  echo
  dim "Or install the systemd user service so it comes back on login:"
  echo "  systemctl --user enable --now amaran-daemon"
fi

echo
ok "Done. The widget polls every few seconds — or press r in the panel."
dim "Config: $CONFIG (keep it private; it holds your mesh keys)"
pause_exit 0
